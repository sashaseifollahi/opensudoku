# Database Configuration
# For local development, leave these unset (uses local SQLite file)
# For production (Vercel/Turso), set these environment variables

# Turso Database URL (required for production)
# Get this from https://turso.tech after creating a database
# TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io

# Turso Auth Token (required for production)
# TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: Rate limiting (future feature)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
