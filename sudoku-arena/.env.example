# Sudoku Arena Configuration

# Environment
NODE_ENV=production

# Server
PORT=3000

# Database
# Uses local SQLite by default at ./data/sudoku-arena.db
# No configuration needed for VPS deployment

# Optional: Turso (if deploying to serverless like Vercel)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Rate limiting (implemented in nginx for VPS)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
